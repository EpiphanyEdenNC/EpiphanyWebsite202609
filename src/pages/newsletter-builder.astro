---
const title = 'Weekly Newsletter Builder';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<title>{title} — Epiphany</title>
<style>
:root{font:16px/1.5 system-ui,Arial,sans-serif;color:#273b36;background:#f5f5f2}
*{box-sizing:border-box}body{margin:0}main{max-width:890px;margin:30px auto;padding:20px}
h1,h2{color:#27443f}.panel{background:#fff;border:1px solid #e3e7e2;padding:24px;border-radius:12px;margin:18px 0}
label{display:block;font-weight:600;margin:12px 0 6px}
input[type=text],input[type=password],textarea,select{font:inherit;width:100%;border:1px solid #a3b2ad;border-radius:6px;padding:10px}
textarea{min-height:90px}.option{display:flex;gap:10px;align-items:start;margin:10px 0}.option label{margin:0;font-weight:400}
button{background:#305c51;color:white;border:0;border-radius:7px;padding:12px 18px;font:inherit;cursor:pointer}
button:disabled{opacity:.55;cursor:not-allowed}.muted{color:#52665c;font-size:.9rem}.event{padding:12px 0;border-bottom:1px solid #ddd}
#preview{border:1px solid #e1e5e1;padding:20px;background:#fafaf9}a{color:#245b60}#status{font-weight:600}#status.error{color:#a22}
</style></head>
<body><main>
<p><a href="/admin">← Return to Tina</a></p>
<h1>Weekly Newsletter</h1>
<p>Create a Mailchimp <strong>draft only</strong> from published website information. Nothing is sent to subscribers from this page.</p>
<div class="panel">
<h2>1. Choose newsletter content</h2>
<label for="subject">Email subject</label><input id="subject" type="text" value="Upcoming Events at Epiphany"/>
<label for="intro">Personal introduction (optional)</label><textarea id="intro" placeholder="A few words for the congregation..."></textarea>
<div class="option"><input type="checkbox" id="service" checked/><label for="service">Include Sunday service information</label></div>
<p id="serviceDescription" class="muted">Loading Sunday service...</p>
<label for="window">Show events through</label>
<select id="window"><option value="7">Next 7 days</option><option value="14">Next 14 days</option><option value="30">Next 30 days</option><option value="90" selected>Next 90 days</option></select>
<p class="muted">Uncheck individual events you don't want in the email.</p>
<div id="events">Loading upcoming events...</div>
<label for="announcement">Additional news and announcements (optional)</label><textarea id="announcement" placeholder="Include items not yet listed on the website..."></textarea>
</div>
<div class="panel">
<h2>2. Review</h2><button type="button" id="previewButton">Refresh preview</button>
<div id="preview" style="margin-top:15px" aria-live="polite"></div>
</div>
<div class="panel">
<h2>3. Create a Mailchimp draft</h2>
<p>Enter the newsletter editor password provided by the church administrator. This is separate from your Tina password.</p>
<label for="password">Newsletter editor password</label><input id="password" type="password" autocomplete="off"/>
<p><button type="button" id="create">Create Mailchimp Draft</button></p>
<p id="status" role="status" aria-live="polite"></p>
</div>
</main>
<script>
const $ = (id) => document.getElementById(id);
let source = { service: null, events: [] };
const escape = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const dateKey = s => {
  const text = String(s || '');
  const date = /^\d{4}-\d{2}-\d{2}/.test(text) ? new Date(text.slice(0,10)+'T12:00:00') : new Date(text);
  return Number.isFinite(date.getTime()) ? date : null;
};
function formatEventDate(value){
 const raw=String(value||'');
 const date=/^\d{4}-\d{2}-\d{2}$/.test(raw) ? new Date(raw+'T12:00:00Z') : new Date(raw);
 if(!Number.isFinite(date.getTime()))return raw;
 return new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',month:'long',day:'numeric',year:'numeric'}).format(date);
}
function renderEvents(){
 const now = new Date(); now.setHours(0,0,0,0);
 const end = new Date(now);end.setDate(end.getDate()+Number($('window').value));
 const chosen = new Set([...document.querySelectorAll('[data-event]:checked')].map(i=>i.dataset.event));
 const initial = !$('events').querySelector('[data-event]');
 const events = source.events.filter(e=>{const d=dateKey(e.date);return d && d>=now && d<=end});
 $('events').innerHTML = events.length ? events.map(e=>'<div class="event"><div class="option"><input type="checkbox" data-event="'+escape(e.id)+'" id="event-'+escape(e.id)+'" '+(initial||chosen.has(e.id)?'checked':'')+'/><label for="event-'+escape(e.id)+'"><strong>'+escape(e.title)+'</strong> — '+escape(formatEventDate(e.date))+'<div class="muted">'+escape(e.summary||'')+'</div></label></div></div>').join('') : '<p>No upcoming events in this period.</p>';
 document.querySelectorAll('[data-event]').forEach(e=>e.addEventListener('change',showPreview));
 showPreview();
}
function selected(){
 const ids=new Set([...document.querySelectorAll('[data-event]:checked')].map(el=>el.dataset.event));
 return {subject:$('subject').value.trim()||'Upcoming Events at Epiphany',intro:$('intro').value.trim(),
  includeService:$('service').checked,service:source.service,
  events:source.events.filter(e=>ids.has(e.id)),announcement:$('announcement').value.trim()};
}
function showPreview(){
 const data=selected(),service=data.includeService&&data.service;
 let html='<h2>Upcoming Events at Epiphany</h2>';
 if(data.intro)html+='<p>'+escape(data.intro).replace(/\n/g,'<br>')+'</p>';
 if(service)html+='<h3>Sunday Worship</h3><p>'+escape(service.heading)+'<br>'+escape(service.date)+' · '+escape(service.time)+'<br>'+escape(service.sundayName||'')+'<br>'+escape(service.priestName||'')+'</p>';
 if(data.events.length)html+='<h3>Upcoming Events</h3>'+data.events.map(e=>'<p><strong>'+escape(e.title)+'</strong><br>'+escape(formatEventDate(e.date))+' '+escape(e.time||'')+'<br>'+escape(e.summary||'')+'</p>').join('');
 if(data.announcement)html+='<h3>News & Announcements</h3><p>'+escape(data.announcement).replace(/\n/g,'<br>')+'</p>';
 $('preview').innerHTML=html+'<p class="muted">Draft preview. Mailchimp adds final email formatting and event links.</p>';
}
async function initialize(){
 try{
  const r=await fetch('/newsletter-data.json',{cache:'no-store'});if(!r.ok)throw Error('Could not load website content');
  source=await r.json();
  $('serviceDescription').textContent=source.service ? [source.service.date,source.service.time,source.service.priestName].filter(Boolean).join(' · ') : 'No Sunday service available';
  renderEvents();
 }catch(e){$('events').textContent=e.message;$('status').textContent='Could not load website data.';$('status').className='error';$('create').disabled=true;}
}
$('window').addEventListener('change',renderEvents);
for(const id of ['subject','intro','service','announcement']) $(id).addEventListener('input',showPreview);
$('previewButton').addEventListener('click',showPreview);
$('create').addEventListener('click',async ()=>{
 const status=$('status');status.className='';
 if(!$('password').value){status.textContent='Enter the newsletter editor password.';status.className='error';return;}
 $('create').disabled=true;status.textContent='Creating the Mailchimp draft…';
 try{
  const r=await fetch('/.netlify/functions/mailchimp-draft',{method:'POST',headers:{'Content-Type':'application/json','X-Newsletter-Password':$('password').value},body:JSON.stringify(selected())});
  const result=await r.json();if(!r.ok)throw Error(result.error||'Unable to create draft');
  $('password').value='';
  status.innerHTML='Draft created. <a href="https://admin.mailchimp.com/campaigns/" target="_blank" rel="noopener noreferrer">Open Mailchimp campaigns</a> to review before sending.';
 }catch(e){status.textContent=e.message;status.className='error';}finally{$('create').disabled=false;}
});
initialize();
</script>
</body></html>
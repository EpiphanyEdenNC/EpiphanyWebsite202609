---
import ContentPage from '../layouts/ContentPage.astro';
import { getPage } from '../lib/content';

const page = getPage('worship');
const buttons = page?.buttons ?? [];
const safe = (url: string) => url && url !== '#';
---
<ContentPage slug="worship">
  {buttons.length > 0 && (
    <section class="section compact" style="padding-top:0">
      <div class="container">
        <div class="actions">
          {buttons.map((button: any) => safe(button.url) && (
            <a
              class:list={['button', button.style === 'secondary' && 'secondary', button.style === 'prayer-book' && 'prayer-book']}
              href={button.url}
              target={button.newWindow ? '_blank' : undefined}
              rel={button.newWindow ? 'noopener noreferrer' : undefined}
            >
              {button.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</ContentPage>

<style>
  .prayer-book {
    background: #a5232b;
    border-color: #a5232b;
    color: #fff;
  }
  .prayer-book:hover,
  .prayer-book:focus-visible {
    background: #861a21;
    border-color: #861a21;
  }
</style>

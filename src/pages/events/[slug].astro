---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEvents, formatDate } from '../../lib/content';
export function getStaticPaths() {
  return getEvents().map((event: any) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event } = Astro.props;
---
<BaseLayout title={event.title} description={event.summary}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">EVENT</p>
      <h1 class="h1">{event.title}</h1>
      <p class="lede">{event.summary}</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container grid-2" style="align-items:start">
      <div>
        <p class="eyebrow">WHEN & WHERE</p>
        <h2 class="h2">{formatDate(event.date)}</h2>
        <p class="lede">{event.time}<br />{event.location}</p>
      </div>
      <div>
        <p class="lede" style="white-space:pre-line">{event.details}</p>
        {event.buttonLabel && event.buttonUrl && <div class="actions"><a class="button" href={event.buttonUrl}>{event.buttonLabel}</a></div>}
      </div>
    </div>
  </section>
</BaseLayout>

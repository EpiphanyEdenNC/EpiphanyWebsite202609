---
import ContentPage from '../layouts/ContentPage.astro';
import { getPage, getMinistries } from '../lib/content';
const page = getPage('serve');
const ministries = getMinistries().filter((m: any) => m.featured);
---
<ContentPage page={page}>
  <section class="section compact" style="padding-top:0">
    <div class="container">
      <div class="ministry-grid">
        {ministries.map((ministry: any) => (
          <article class="ministry">
            <h3>{ministry.title}</h3>
            <p><strong>{ministry.summary}</strong></p>
            <p>{ministry.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</ContentPage>

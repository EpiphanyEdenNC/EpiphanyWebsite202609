---
import BaseLayout from './BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ContentBody from '../components/islands/ContentBody.astro';
import { getPageTina, getAboutPageTina } from '../lib/tina-data';
import { islands } from '../lib/islands';

interface Props { slug: string; }
const { slug } = Astro.props;
const isAboutChild = slug.startsWith('about-');
const islandName = isAboutChild ? 'aboutPage' : 'page';
const page = isAboutChild
  ? (await getAboutPageTina(slug)).data?.aboutPage
  : (await getPageTina(slug)).data?.page;
if (!page) throw new Error(`Page content not found: ${slug}`);
---
<BaseLayout
  title={slug === 'welcome' ? 'Visit an Episcopal Church in Eden, NC' : slug === 'worship' ? 'Sunday Worship in Eden, NC' : page.title}
  description={page.intro || undefined}
  image={page.headerImage}
  imageAlt={page.headerImageAlt}
>
  <TinaIsland name={islandName} wrapper={islands[islandName].wrapper} params={{ slug }} primary>
    <ContentBody data={page} />
  </TinaIsland>
  <slot />
</BaseLayout>

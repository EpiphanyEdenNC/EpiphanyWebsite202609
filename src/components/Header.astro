---
import { site } from '../lib/content';
const path = Astro.url.pathname;
const headerSignup = site.header?.emailSignup;
const showEmailSignup = headerSignup?.enabled && headerSignup.url && headerSignup.url !== '#';
const nav = site.header?.navigationLinks ?? [];
const giveButton = site.header?.giveButton;
const showGiveButton = giveButton?.enabled && giveButton.url && giveButton.url !== '#';
---
<a class="skip-link" href="#main">Skip to main content</a>
<div class="topbar">
  <div class="container">
    <span>Sunday worship · {site.sundayTime}</span>
    <span class="secondary-top">Everyone is welcome.</span>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.churchName} home`}>
      <strong>{site.churchName}</strong>
      <span>{site.tagline}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Primary navigation">
      {nav.filter((link) => link.label && link.url && link.url !== '#').map((link) => <a href={link.url} aria-current={path === link.url ? 'page' : undefined}>{link.label}</a>)}
      {showEmailSignup && <a class="signup" href={headerSignup.url}>{headerSignup.label || 'Email Sign Up'}</a>}
      {showGiveButton && <a class="give" href={giveButton.url} aria-current={path === giveButton.url ? 'page' : undefined}>{giveButton.label || 'Give'}</a>}
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#site-nav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    button.setAttribute('aria-expanded', String(open));
  });
</script>

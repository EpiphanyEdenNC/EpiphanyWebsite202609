---
import { site, getAboutPages } from '../lib/content';
const path = Astro.url.pathname;
const headerSignup = site.header?.emailSignup;
const showEmailSignup = headerSignup?.enabled && headerSignup.url && headerSignup.url !== '#';
const textSignup = site.header?.textSignup;
const showTextSignup = textSignup?.enabled && textSignup.url && textSignup.url !== '#';
type NavLink = { label: string; url: string; hidden?: boolean; children?: NavLink[] };
const nav: NavLink[] = (site.header?.navigationLinks ?? []).map((link) => link.url.replace(/\/$/, '') === '/about' ? {
  ...link,
  children: [
    ...getAboutPages().map((page) => ({ label: page.title, url: page.url })),
    ...(link.children ?? []).filter((child) => !child.url.startsWith('/about/')),
  ],
} : link);
const visibleLinks = (links: NavLink[]) => links.filter((link) => !link.hidden && link.label && link.url && link.url !== '#');
const giveButton = site.header?.giveButton;
const showGiveButton = giveButton?.enabled && giveButton.url && giveButton.url !== '#';
const pledgeButton = site.header?.pledgeButton;
const showPledgeButton = pledgeButton?.enabled && pledgeButton.url && pledgeButton.url !== '#';
const actionMenus = [
  {
    label: 'Sign Up',
    id: 'submenu-signup',
    style: 'signup',
    children: [
      ...(showEmailSignup ? [{ label: headerSignup.label || 'Email Sign Up', url: headerSignup.url }] : []),
      ...(showTextSignup ? [{ label: textSignup.label || 'Text Sign Up', url: textSignup.url }] : []),
    ],
  },
  {
    label: 'Give',
    id: 'submenu-give',
    style: 'give',
    children: [
      ...(showGiveButton ? [{ label: giveButton.label || 'Give', url: giveButton.url }] : []),
      ...(showPledgeButton ? [{ label: pledgeButton.label || 'Pledge', url: pledgeButton.url }] : []),
    ],
  },
].filter((menu) => menu.children.length > 0);
---
<a class="skip-link" href="#main">Skip to main content</a>
<div class="topbar">
  <div class="container">
    <span>Sunday worship · {site.sundayTime}</span>
    <span class="secondary-top">Everyone is welcome.</span>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.churchName} home`}>
      <strong>{site.churchName}</strong>
      <span>{site.tagline}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Primary navigation">
      {visibleLinks(nav).map((link, index) => {
        const children = visibleLinks(link.children ?? []);
        return children.length ? (
          <div class="nav-group">
            <div class="nav-parent">
              <a href={link.url} aria-current={path === link.url ? 'page' : undefined} class:list={{ 'nav-ancestor': children.some((child) => path === child.url) }}>{link.label}</a>
              <button class="submenu-toggle" type="button" aria-expanded="false" aria-controls={`submenu-${index}`} aria-label={`${link.label} submenu`}><span aria-hidden="true">⌄</span></button>
            </div>
            <div class="nav-submenu" id={`submenu-${index}`} hidden>
              {children.map((child) => <a href={child.url} aria-current={path === child.url ? 'page' : undefined}>{child.label}</a>)}
            </div>
          </div>
        ) : <a href={link.url} aria-current={path === link.url ? 'page' : undefined}>{link.label}</a>;
      })}
      {actionMenus.map((menu) => (
        <div class="nav-group">
          <div class="nav-parent">
            <button
              class:list={['submenu-toggle', 'nav-action-toggle', menu.style, { 'nav-ancestor': menu.children.some((child) => path === child.url) }]}
              type="button"
              aria-expanded="false"
              aria-controls={menu.id}
            >
              {menu.label} <span aria-hidden="true">⌄</span>
            </button>
          </div>
          <div class="nav-submenu nav-action-submenu" id={menu.id} hidden>
            {menu.children.map((child) => (
              <a href={child.url} aria-current={path === child.url ? 'page' : undefined}>{child.label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.nav-group'));
  function setOpen(group: HTMLElement, open: boolean) {
    group.querySelector('button')?.setAttribute('aria-expanded', String(open));
    const submenu = group.querySelector<HTMLElement>('.nav-submenu');
    if (submenu) submenu.hidden = !open;
  }
  function closeAll(except?: HTMLElement) {
    groups.forEach((group) => { if (group !== except) setOpen(group, false); });
  }
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    button.setAttribute('aria-expanded', String(open));
    if (!open) closeAll();
  });
  groups.forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>('.submenu-toggle');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      closeAll(group);
      setOpen(group, open);
    });
    group.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && window.matchMedia('(min-width: 1201px)').matches) {
        closeAll(group);
        setOpen(group, true);
      }
    });
    group.addEventListener('pointerleave', () => {
      if (window.matchMedia('(min-width: 1201px)').matches && !group.contains(document.activeElement)) setOpen(group, false);
    });
    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) setOpen(group, false);
    });
  });
  document.addEventListener('click', (event) => {
    if (!nav?.contains(event.target as Node)) {
      closeAll();
      if (event.target !== button) {
        nav?.classList.remove('open');
        button?.setAttribute('aria-expanded', 'false');
      }
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const active = groups.find((group) => group.querySelector('button')?.getAttribute('aria-expanded') === 'true');
    if (active) {
      setOpen(active, false);
      active.querySelector<HTMLButtonElement>('button')?.focus();
    } else if (nav?.classList.contains('open')) {
      nav.classList.remove('open');
      button?.setAttribute('aria-expanded', 'false');
      button?.focus();
    }
  });
</script>

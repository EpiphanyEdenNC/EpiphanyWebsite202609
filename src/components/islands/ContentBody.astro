---
import { tinaField } from '@tinacms/astro/tina-field';
import ContactCards from '../ContactCards.astro';
import OptimizedImage from '../OptimizedImage.astro';
const { data: page } = Astro.props;
const summaryCards = page?.summaryCards || [];
const isConnectPage = page?._sys?.filename === 'connect';
---
{page && (
  <>
    <section class="page-hero">
      <div class="container">
        {page.headerImage && (
          <OptimizedImage
            class="page-header-image"
            src={page.headerImage}
            alt={page.headerImageAlt || ''}
            data-tina-field={tinaField(page, 'headerImage')}
          />
        )}
        {page.eyebrow && <p class="eyebrow" data-tina-field={tinaField(page, 'eyebrow')}>{page.eyebrow}</p>}
        <h1 class="h1" data-tina-field={tinaField(page, 'title')}>{page.title}</h1>
        {page.intro && <p class="lede page-intro" data-tina-field={tinaField(page, 'intro')}>{page.intro}</p>}
      </div>
    </section>
    <section class="section compact">
      <div class="container page-sections">
        {isConnectPage && (
          <>
            <div class="page-section" id="contact">
              <h2>Contact us</h2>
              <p>Call or email us, or get directions to the church. We would be glad to hear from you.</p>
            </div>
            <ContactCards />
          </>
        )}
        {summaryCards.length > 0 && (
          <div class="summary-grid">
            {summaryCards.filter((card) => card.heading && card.url && card.url !== '#').map((card) => (
              <a class="card summary-card" href={card.url} data-tina-field={tinaField(card)}>
                <h2 data-tina-field={tinaField(card, 'heading')}>{card.heading}</h2>
                <p data-tina-field={tinaField(card, 'text')}>{card.text}</p>
                <span class="summary-arrow" aria-hidden="true">Learn more →</span>
              </a>
            ))}
          </div>
        )}
        {(page.sections || []).map((section) => (
          <article class="page-section" id={section.anchor || undefined} data-tina-field={tinaField(section)}>
            <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
            <p data-tina-field={tinaField(section, 'text')}>{section.text}</p>
          </article>
        ))}
        {(page.buttons || []).some((button) => button.label && button.url && button.url !== '#') && (
          <div class="actions" data-tina-field={tinaField(page, 'buttons')}>
            {(page.buttons || []).filter((button) => button.label && button.url && button.url !== '#').map((button) => (
              <a class:list={['button', button.style === 'secondary' && 'secondary', button.style === 'prayer-book' && 'prayer-book']}
                href={button.url} target={button.newWindow ? '_blank' : undefined}
                rel={button.newWindow ? 'noopener noreferrer' : undefined} data-tina-field={tinaField(button)}>
                {button.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </>
)}

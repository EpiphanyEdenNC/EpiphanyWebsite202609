---
import { tinaField } from '@tinacms/astro/tina-field';
import { site, getEvents, formatDate } from '../../lib/content';
import { getGeneratedWebp } from '../../lib/images';
import OptimizedImage from '../OptimizedImage.astro';
const { data: home } = Astro.props;
const events = getEvents().filter((event) => event.featured);
const heroWebp = getGeneratedWebp(home?.heroImage);
const heroStyle = home?.heroImage
  ? heroWebp
    ? `background-image:url('${home.heroImage}');background-image:image-set(url('${heroWebp}') type("image/webp"),url('${home.heroImage}'))`
    : `background-image:url('${home.heroImage}')`
  : undefined;
const safe = (url: string) => url && url !== '#';
---
{home && (
  <>
    <section
      class:list={["hero", home.heroImage && "has-image"]}
      style={heroStyle}
      data-tina-field={tinaField(home, 'heroImage')}
    >
      <div class="container hero-inner">
        <p class="eyebrow" data-tina-field={tinaField(home, 'eyebrow')}>{home.eyebrow}</p>
        <h1 class="display" data-tina-field={tinaField(home, 'headline')}>{home.headline}</h1>
        <p class="lede" data-tina-field={tinaField(home, 'subheadline')}>{home.subheadline}</p>
        <div class="actions">
          <a class="button" href={home.primaryButtonUrl} data-tina-field={tinaField(home, 'primaryButtonLabel')}>{home.primaryButtonLabel}</a>
          <a class="button secondary" href={home.secondaryButtonUrl} data-tina-field={tinaField(home, 'secondaryButtonLabel')}>{home.secondaryButtonLabel}</a>
        </div>
      </div>
    </section>

    {home.quickLinks?.length > 0 && (
      <div class="container quick-strip" aria-label="Quick information">
        <div class="quick-strip-inner" data-tina-field={tinaField(home, 'quickLinks')}>
          {home.quickLinks.map((link) => (
            <a class="quick" href={link.url}>
              <small data-tina-field={tinaField(link, 'label')}>{link.label}</small>
              <strong data-tina-field={tinaField(link, 'text')}>{link.text}</strong>
            </a>
          ))}
        </div>
      </div>
    )}

    <section class="section">
      <div class="container grid-2">
        <div>
          <p class="eyebrow">WELCOME</p>
          <h2 class="h2" data-tina-field={tinaField(home, 'welcomeHeading')}>{home.welcomeHeading}</h2>
        </div>
        <div>
          <p class="lede" data-tina-field={tinaField(home, 'welcomeText')}>{home.welcomeText}</p>
          <div class="actions"><a class="button secondary" href="/welcome">Plan Your Visit</a></div>
        </div>
      </div>
    </section>

    {home.sundayService && (
      <section class="section compact sunday-service-section">
        <div class="container">
          <article class="sunday-service-card" data-tina-field={tinaField(home, 'sundayService')}>
            <div class="sunday-service-photo-wrap">
              {home.sundayService.priestImage ? (
                <OptimizedImage
                  class="sunday-service-photo"
                  src={home.sundayService.priestImage}
                  alt={home.sundayService.priestName ? `${home.sundayService.priestName}, Sunday service priest` : 'Sunday service priest'}
                  loading="lazy"
                  data-tina-field={tinaField(home.sundayService, 'priestImage')}
                />
              ) : (
                <div class="sunday-service-photo-placeholder" data-tina-field={tinaField(home.sundayService, 'priestImage')}>
                  Priest photo
                </div>
              )}
            </div>

            <div class="sunday-service-content">
              <p class="eyebrow">THIS SUNDAY</p>
              <h2 class="h2" data-tina-field={tinaField(home.sundayService, 'heading')}>
                {home.sundayService.heading || 'Sunday Service'}
              </h2>

              <div class="sunday-service-details">
                <div>
                  <span>Date</span>
                  <strong data-tina-field={tinaField(home.sundayService, 'date')}>{home.sundayService.date}</strong>
                </div>
                <div>
                  <span>Time</span>
                  <strong data-tina-field={tinaField(home.sundayService, 'time')}>{home.sundayService.time}</strong>
                </div>
                {home.sundayService.location && (
                  <div>
                    <span>Location</span>
                    <strong data-tina-field={tinaField(home.sundayService, 'location')}>{home.sundayService.location}</strong>
                  </div>
                )}
              </div>

              <h3 class="sunday-name" data-tina-field={tinaField(home.sundayService, 'sundayName')}>
                {home.sundayService.sundayName}
              </h3>

              <div class="sunday-service-priest">
                <p class="priest-name" data-tina-field={tinaField(home.sundayService, 'priestName')}>
                  {home.sundayService.priestName}
                </p>
                {home.sundayService.priestBio && (
                  <p class="priest-bio" data-tina-field={tinaField(home.sundayService, 'priestBio')}>
                    {home.sundayService.priestBio}
                  </p>
                )}
              </div>

              {home.sundayService.buttons?.length > 0 && (
                <div class="actions sunday-service-links" data-tina-field={tinaField(home.sundayService, 'buttons')}>
                  {home.sundayService.buttons.map((button) => (
                    button?.label && button?.url && (
                      <a
                        class:list={["button", button.style === 'secondary' && "secondary"]}
                        href={button.url}
                        target={button.newWindow ? "_blank" : undefined}
                        rel={button.newWindow ? "noopener noreferrer" : undefined}
                        data-tina-field={tinaField(button, 'label')}
                      >
                        {button.label}
                      </a>
                    )
                  ))}
                </div>
              )}

              {home.sundayService.additionalInfo && (
                <p class="sunday-service-additional" data-tina-field={tinaField(home.sundayService, 'additionalInfo')}>
                  {home.sundayService.additionalInfo}
                </p>
              )}
            </div>
          </article>
        </div>
      </section>
    )}

    <section class="section compact">
      <div class="container grid-2">
        <div class="feature-block">
          <p class="eyebrow" style="color:#f0c6b5">WORSHIP</p>
          <h2 class="h2" data-tina-field={tinaField(home, 'serviceHeading')}>{home.serviceHeading}</h2>
          <p class="lede" data-tina-field={tinaField(home, 'serviceText')}>{home.serviceText}</p>
          <div class="actions"><a class="button light" href={home.serviceButtonUrl} data-tina-field={tinaField(home, 'serviceButtonLabel')}>{home.serviceButtonLabel}</a></div>
        </div>
        <div class="feature-block clay">
          <p class="eyebrow" style="color:#f6e0d7">OUTREACH</p>
          <h2 class="h2" data-tina-field={tinaField(home, 'outreachHeading')}>{home.outreachHeading}</h2>
          <p class="lede" data-tina-field={tinaField(home, 'outreachText')}>{home.outreachText}</p>
          <div class="actions"><a class="button ghost-light" href={home.outreachButtonUrl} data-tina-field={tinaField(home, 'outreachButtonLabel')}>{home.outreachButtonLabel}</a></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="events-head">
          <div>
            <p class="eyebrow">UPCOMING</p>
            <h2 class="h2">What's happening</h2>
          </div>
          <a href="/events">View all events →</a>
        </div>
        <div class="cards">
          {events.map((event) => (
            <article class="event-card" data-home-event data-event-date={String(event.date).slice(0, 10)}>
              {event.image && <OptimizedImage class="event-card-image" src={event.image} alt={event.title} loading="lazy" />}
              <div class="grow">
                <div class="event-date">{formatDate(event.date)}</div>
                <h3>{event.title}</h3>
                <p class="meta">{event.time}{event.location ? ` · ${event.location}` : ''}</p>
                <p>{event.summary}</p>
              </div>
              <a href={`/events/${event.routeSlug}`}>Event details →</a>
            </article>
          ))}
        </div>
        <script is:inline>
          (() => {
            const parts = new Intl.DateTimeFormat('en-US', {
              timeZone: 'America/New_York',
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
            }).formatToParts(new Date());

            const dateParts = Object.fromEntries(
              parts
                .filter((part) => part.type !== 'literal')
                .map((part) => [part.type, part.value])
            );

            const today = `${dateParts.year}-${dateParts.month}-${dateParts.day}`;
            let shown = 0;

            document.querySelectorAll('[data-home-event]').forEach((card) => {
              const eventDate = card.getAttribute('data-event-date') || '';
              const shouldShow = eventDate >= today && shown < 3;
              card.hidden = !shouldShow;
              if (shouldShow) shown += 1;
            });
          })();
        </script>
        <div class="actions">
          <a class="button secondary" href="/events">All Events →</a>
        </div>
      </div>
    </section>

    <section class="section closing">
      <div class="container grid-2">
        <div><h2 class="h2" data-tina-field={tinaField(home, 'closingHeading')}>{home.closingHeading}</h2></div>
        <div>
          <p class="lede" data-tina-field={tinaField(home, 'closingText')}>{home.closingText}</p>
          <div class="actions">
            <a class="button light" href="/connect#contact">Contact Us</a>
            {safe(site.youtubeUrl) && <a class="button ghost-light" href={site.youtubeUrl}>Watch on YouTube</a>}
          </div>
        </div>
      </div>
    </section>
  </>
)}

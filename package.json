{
  "name": "epiphany-astro-tina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "npm run optimize-images && tinacms build --content=local --verbose -c \"astro build\"",
    "build:local": "npm run optimize-images && tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "preview": "astro preview",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "@astrojs/netlify": "^8.2.6",
    "@tinacms/astro": "^0.7.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tinacms/cli": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.14.0",
    "typescript": "^6.0.3"
  }
}
